@baseUrl = http://localhost:3000
@token = 

### 注册守护端账号
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "123456",
  "name": "守护者A",
  "role": "GUARDIAN",
  "deviceId": "guardian-device-001"
}

### 注册老人端账号
POST {{baseUrl}}/api/auth/register
Content-Type: application/json

{
  "phone": "13800000002",
  "password": "123456",
  "name": "老人A",
  "role": "ELDER",
  "deviceId": "elder-device-001"
}

### 守护端登录
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "123456",
  "clientRole": "GUARDIAN",
  "deviceId": "guardian-device-001"
}

### 老人端登录
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000002",
  "password": "123456",
  "clientRole": "ELDER",
  "deviceId": "elder-device-001"
}

### 角色不匹配测试（应返回 403）
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000002",
  "password": "123456",
  "clientRole": "GUARDIAN",
  "deviceId": "elder-device-001"
}

### 挤下线测试步骤1：设备A登录
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "123456",
  "clientRole": "GUARDIAN",
  "deviceId": "guardian-device-A"
}

### 挤下线测试步骤2：设备B登录同一账号
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "phone": "13800000001",
  "password": "123456",
  "clientRole": "GUARDIAN",
  "deviceId": "guardian-device-B"
}

### 使用设备A旧token请求 profile（应返回 401）
GET {{baseUrl}}/api/auth/profile
Authorization: Bearer {{token}}

### 老人端生成配对码
POST {{baseUrl}}/api/bind/generate
Authorization: Bearer {{token}}
Content-Type: application/json

{}

### 守护端输入配对码绑定
POST {{baseUrl}}/api/bind/verify
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "code": "123456",
  "nickname": "爷爷"
}

### 查询家人列表
GET {{baseUrl}}/api/family/members
Authorization: Bearer {{token}}

### 守护端发起取消绑定（需传 elderId）
POST {{baseUrl}}/api/family/unbind
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "elderId": "elder-user-id"
}

### 老人端发起取消绑定（需传 guardianId）
POST {{baseUrl}}/api/family/unbind
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "guardianId": "guardian-user-id"
}

### Dashboard - 守护端获取老人设备状态
GET {{baseUrl}}/api/family/dashboard
Authorization: Bearer {{token}}
